# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Browsers allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres, as the gardener_api role. Locally through a tunnel:
#   ssh -N -L 54322:127.0.0.1:5432 root@169.58.223.190
# (5432 there is Supavisor, so the user carries the tenant suffix)
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USER=gardener_api.hozza
DB_PASSWORD=
DB_DATABASE=postgres

# Supabase API + publishable key (checks callers' tokens)
SUPABASE_URL=https://supabase.hozza.dev
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://gardener.hozza.dev

# Leave off locally so a dev API never sends real notifications
REMINDERS_ENABLED=false
